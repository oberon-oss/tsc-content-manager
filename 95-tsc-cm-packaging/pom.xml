        </dependency>
        <dependency>
            <groupId>eu.oberon-oss.tsc</groupId>
            <artifactId>80-tsc-cm-cli</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>deb</id>
            <modules>
                <module>deb</module>
            </modules>
        </profile>
        <profile>
            <id>rpm</id>
            <modules>
                <module>rpm</module>
