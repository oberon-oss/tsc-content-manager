#!/usr/bin/env bash
set -e

# Base directory for application libraries
if [ -z "$APP_HOME" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    APP_HOME="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi
LIB_DIR="${APP_HOME}/lib"

# Construct wildcard classpath to include all tool and dependency JARs
CLASSPATH="${LIB_DIR}/*"

# Locate Java runtime
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVA_CMD="$JAVA_HOME/bin/java"
else
    JAVA_CMD="java"
fi

# Configure JVM options
JAVA_OPTIONS="${JAVA_OPTIONS} --enable-native-access=ALL-UNNAMED"

# Execute ToolRunner with all supplied arguments
exec "$JAVA_CMD" ${JAVA_OPTIONS} -cp "$CLASSPATH" eu.oberon.oss.tsc.cm.cli.ToolRunner "$@"
