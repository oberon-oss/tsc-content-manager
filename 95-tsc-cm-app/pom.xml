<?xml version="1.0" encoding="UTF-8"?>
<!--suppress MavenModelInspection -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.oberon-oss.tsc</groupId>
        <artifactId>tsc-content-manager</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>95-tsc-cm-app</artifactId>

    <name>95-tsc-cm-app</name>
    <description>Main application module for tsc-content-manager</description>

    <properties>
        <sonar.skip>true</sonar.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>eu.oberon-oss.tsc</groupId>
            <artifactId>01-tsc-cm-base</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.oberon-oss.tsc</groupId>
            <artifactId>20-tsc-cm-io</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.oberon-oss.tsc</groupId>
            <artifactId>60-tsc-cm-shared</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.oberon-oss.tsc</groupId>
            <artifactId>70-tsc-cm-gui</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.oberon-oss.tsc</groupId>
            <artifactId>80-tsc-cm-cli</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/staging/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.vafer</groupId>
                <artifactId>jdeb</artifactId>
                <version>1.11</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>jdeb</goal>
                        </goals>
                        <configuration>
                            <deb>${project.build.directory}/tsc-content-manager_${project.version}_all.deb</deb>
                            <controlDir>${project.basedir}/src/deb/control</controlDir>
                            <dataSet>
                                <data>
                                    <src>${project.build.directory}/staging/lib</src>
                                    <type>directory</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/tsc-content-manager/lib</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/src/deb/bin/tool-runner</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/tsc-content-manager/bin</prefix>
                                        <filemode>755</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/src/deb/bin/tool-runner</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/bin</prefix>
                                        <filemode>755</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/src/deb/doc/copyright</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/doc/tsc-content-manager</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/src/deb/doc/changelog.gz</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/doc/tsc-content-manager</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/src/deb/man/tool-runner.1.gz</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/man/man1</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/src/deb/lintian/tsc-content-manager</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/lintian/overrides</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                            </dataSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>rpm-maven-plugin</artifactId>
                <version>2.3.0</version>
                <executions>
                    <execution>
                        <id>generate-rpm</id>
                        <phase>package</phase>
                        <goals>
                            <goal>rpm</goal>
                        </goals>
                        <configuration>
                            <name>tsc-content-manager</name>
                            <version>${project.version}</version>
                            <group>Applications/System</group>
                            <license>Proprietary</license>
                            <packager>Oberon OSS</packager>
                            <description>Main application package for tsc-content-manager</description>
                            <mappings>
                                <!-- Application libraries -->
                                <mapping>
                                    <directory>/usr/share/tsc-content-manager/lib</directory>
                                    <filemode>644</filemode>
                                    <username>root</username>
                                    <groupname>root</groupname>
                                    <sources>
                                        <source>
                                            <location>${project.build.directory}/staging/lib</location>
                                        </source>
                                    </sources>
                                </mapping>
                                <!-- Executables -->
                                <mapping>
                                    <directory>/usr/share/tsc-content-manager/bin</directory>
                                    <filemode>755</filemode>
                                    <username>root</username>
                                    <groupname>root</groupname>
                                    <sources>
                                        <source>
                                            <location>${project.basedir}/src/deb/bin/tool-runner</location>
                                        </source>
                                    </sources>
                                </mapping>
                                <mapping>
                                    <directory>/usr/bin</directory>
                                    <filemode>755</filemode>
                                    <username>root</username>
                                    <groupname>root</groupname>
                                    <sources>
                                        <source>
                                            <location>${project.basedir}/src/deb/bin/tool-runner</location>
                                        </source>
                                    </sources>
                                </mapping>
                                <!-- Documentation -->
                                <mapping>
                                    <directory>/usr/share/doc/tsc-content-manager</directory>
                                    <filemode>644</filemode>
                                    <username>root</username>
                                    <groupname>root</groupname>
                                    <sources>
                                        <source>
                                            <location>${project.basedir}/src/deb/doc/copyright</location>
                                        </source>
                                        <source>
                                            <location>${project.basedir}/src/deb/doc/changelog.gz</location>
                                        </source>
                                    </sources>
                                </mapping>
                                <!-- Man pages -->
                                <mapping>
                                    <directory>/usr/share/man/man1</directory>
                                    <filemode>644</filemode>
                                    <username>root</username>
                                    <groupname>root</groupname>
                                    <sources>
                                        <source>
                                            <location>${project.basedir}/src/deb/man/tool-runner.1.gz</location>
                                        </source>
                                    </sources>
                                </mapping>
                            </mappings>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
